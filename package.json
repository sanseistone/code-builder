{
  "name": "html-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTML 模板生成工具集：多项目管理，共享组件 / 逻辑 / 样式，支持在线部署与离线单文件",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir dist-check",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.103.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.0"
  }
}
